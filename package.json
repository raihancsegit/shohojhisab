{
  "name": "local-business-os-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node dev.js",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "build": "npm run build --workspaces",
    "start": "npm run start --prefix apps/web"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}